<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        The link between the player's two phones (ADR-0009, decisions 2 and 11): a TLS socket from the
        Player's phone to its paired Mounted camera on the same Wi-Fi, found by NSD, never to a server.
        Code, not this permission, keeps it local: the local-peer check and the pinned TLS. The Play
        Billing Library's datatransport would use INTERNET for its usage logging; its only backend is
        excluded in Gradle, so that logging still has no route off the phone (decision 12).
        ACCESS_NETWORK_STATE picks the Wi-Fi network to connect through; CHANGE_WIFI_MULTICAST_STATE
        takes the MulticastLock NSD needs below T extensions 7.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!--
        The Mounted camera's captures through CameraX (ADR-0009, decision 11). Once declared, the
        system camera intent behind the handheld Take a Photo needs it granted too, so that path asks
        for it first (phase-G.md D5). CAMERA implies both features as required, which would hide the
        app from every phone without a camera for a role few use; both are declared optional.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!--
        Package visibility (API 30+). The first three <intent> entries are for hand-offs to a mail
        app, Play and a browser. None of the launches needs them — package visibility has never
        blocked `startActivity`, and each launch is a try/catch around `ActivityNotFoundException`.
        What visibility *does* block is `resolveActivity`, which would answer "no mail app" on every
        phone that has one. Nothing performs such a pre-check today; these entries exist so one added
        later cannot silently lie.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!--
        `android:localeConfig` is read by Android 13+ only, which is what tools:targetApi records —
        it silences lint's "unused below minSdk" note without weakening anything at runtime. Older
        devices ignore the attribute and AppCompat's backport reads the same file, so the list of
        shipped languages stays in one place across the whole supported range (ADR-0004).
    -->
    <application
        android:name=".MainApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.App"
        tools:targetApi="33">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The camera app writes the photo it takes into a file we own, and hands back a Uri for
            it. A file:// Uri has been illegal to pass across apps since Android 7, so this provider
            vends a content:// one instead, scoped to the single cache directory in file_paths.xml.
            Photo Picker needs none of this — it hands us a Uri of its own — but "take a photo"
            does.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            Not a service anybody starts — `android:enabled="false"` means it can never run. It is a
            manifest entry used as a storage slot: AppCompat looks itself up here, reads the
            `autoStoreLocales` flag, and takes responsibility for persisting the chosen language on
            devices below 13, where the platform has no per-app locale store of its own. On 13+ the
            framework persists it and this is ignored.

            Chosen over a DataStore key deliberately (ADR-0004): DataStore reads are asynchronous —
            a Flow, so `suspend` before the value exists — and the app would already have drawn its
            first frame in the phone's language before the stored one resolved.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
