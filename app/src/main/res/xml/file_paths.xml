<?xml version="1.0" encoding="utf-8"?>
<!--
    Two directories, both narrow.

    camera/ is shared with the camera app we hand a Uri to: a staging area holding the just-taken
    shot. MediaFiles re-encodes the picture into filesDir/images and the original is dropped, so
    nothing durable is exposed.

    preserved/ holds ADR-0001's pre-wipe database copies, and is shared only on the owner's own
    explicit "share" tap — a copy they cannot get off the phone is only marginally better than no
    copy at all. Neither the live database nor the media directories are listed here.
-->
<paths>
    <cache-path
        name="camera"
        path="camera/" />
    <files-path
        name="preserved"
        path="preserved/" />
</paths>
